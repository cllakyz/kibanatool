{
  "name": "kibanatool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that speeds up working with logs in Kibana Discover (7.17, 8.x, 9.x)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/icons.mjs",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "dependencies": {
    "lz-string": "1.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rison-node": "^2.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
